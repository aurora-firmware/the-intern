{
    "compilerOptions": {
        "strict": true,
        "noEmit": true,
        "erasableSyntaxOnly": true,
        "verbatimModuleSyntax": true,
        "allowImportingTsExtensions": true,
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "target": "es2024",
        "types": ["node"],
        "rootDirs": ["web/ui", "src"],
        "skipLibCheck": true
    },
    "include": ["src", "test"]
}
