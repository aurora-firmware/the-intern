{
    "name": "the-intern",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "engines": {
        "node": ">=24"
    },
    "dependencies": {
        "@earendil-works/chord": "1.4.0",
        "@earendil-works/pi-ai": "1.4.0",
        "@earendil-works/pi-coding-agent": "1.4.0",
        "@earendil-works/pi-durable": "1.4.0",
        "amaro": "1.1.11",
        "preact": "11.1.1",
        "smol-toml": "1.9.1"
    },
    "devDependencies": {
        "@biomejs/biome": "2.6.4",
        "@types/node": "24.19.2",
        "axe-core": "4.14.0",
        "playwright-core": "1.65.0",
        "typescript": "7.0.2",
        "vitepress": "1.6.4"
    },
    "scripts": {
        "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json",
        "format": "biome format --write",
        "format:check": "biome format",
        "lint": "biome check",
        "test": "node --test \"test/**/*.test.ts\"",
        "test:unit": "node --test \"test/unit/**/*.test.ts\"",
        "test:service": "node --test \"test/service/**/*.test.ts\"",
        "test:live": "node test/live/live_daemon.ts",
        "test:live:agents": "node test/live/live_agents.ts",
        "test:live:jobs": "node test/live/live_jobs.ts",
        "test:live:desk": "node test/live/live_desk.ts",
        "docs:build": "vitepress build docs/manual",
        "check": "npm run typecheck && npm run lint && npm run test"
    }
}
