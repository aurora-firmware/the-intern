{
    "name": "the-intern",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "engines": {
        "node": ">=24"
    },
    "dependencies": {
        "@earendil-works/chord": "1.4.0",
        "@earendil-works/pi-ai": "1.4.0",
        "@earendil-works/pi-coding-agent": "1.4.0",
        "@earendil-works/pi-durable": "1.4.0",
        "smol-toml": "1.9.1"
    },
    "devDependencies": {
        "@biomejs/biome": "2.6.4",
        "@types/node": "24.19.2",
        "typescript": "7.0.2",
        "vitepress": "1.6.4"
    },
    "scripts": {
        "typecheck": "tsc --noEmit",
        "format": "biome format --write",
        "format:check": "biome format",
        "lint": "biome check",
        "test": "node --test \"test/**/*.test.ts\"",
        "test:unit": "node --test \"test/unit/**/*.test.ts\"",
        "test:service": "node --test \"test/service/**/*.test.ts\"",
        "docs:build": "vitepress build docs/manual",
        "check": "npm run typecheck && npm run lint && npm run test"
    }
}
