{
    "compilerOptions": {
        "strict": true,
        "noEmit": true,
        "erasableSyntaxOnly": true,
        "verbatimModuleSyntax": true,
        "allowImportingTsExtensions": true,
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "target": "es2024",
        "lib": ["es2024", "dom", "dom.iterable"],
        "types": [],
        "rootDirs": ["ui", "../src"],
        "skipLibCheck": true
    },
    "include": ["ui"],
    "exclude": ["ui/feed_worker.ts"]
}
